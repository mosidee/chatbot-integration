{
  "name": "chatbot-integration",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"bun run dev:api\" \"bun run dev:worker\" \"bun run dev:web\"",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:seed": "bun run packages/db/src/seed.ts",
    "auth:generate": "bunx auth@1.7.5 generate --config packages/db/src/auth-config.ts --output packages/db/src/schema/auth.ts --yes",
    "test": "bun test apps packages",
    "typecheck": "tsc -p tsconfig.json && cd apps/web && tsc -p tsconfig.json && cd ../widget && tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build:web": "cd apps/web && bun run build",
    "build:widget": "cd apps/widget && bun run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:reset": "bun run scripts/db-reset.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "concurrently": "10.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
