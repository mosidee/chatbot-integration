# ---- Core ----
NODE_ENV=development
# 32-byte base64 key for AES-256-GCM encryption of provider API keys and channel secrets.
# Generate with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
APP_SECRET_KEY=

# ---- Database ----
DATABASE_URL=postgres://ci:ci_dev_password@localhost:5432/chatbot_integration
# Used by docker-compose.yml to create the database user and to build DATABASE_URL for the
# containers. Required for a container deployment; ignored when running the apps natively.
POSTGRES_PASSWORD=ci_dev_password

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Object storage ----
# An http(s) endpoint uses S3-compatible storage (MinIO in Docker, R2 or S3 in production).
#
# On macOS with Colima, a host process cannot talk to the MinIO container: the port
# forwarder corrupts SigV4-signed requests, so every call fails with InvalidAccessKeyId
# even though containers on the same network work. Use filesystem storage locally instead:
#   S3_ENDPOINT=file://./.data/media
# The remaining S3_* values are then ignored.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/media

# ---- Auth (Better Auth) ----
# Generate with the same command as APP_SECRET_KEY
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Public URLs ----
API_PORT=3000
WORKER_HEALTH_PORT=3001
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
# Base URL that LINE/Messenger webhooks are registered against (staging/production)
WEBHOOK_BASE_URL=http://localhost:3000

# ---- Tenant-defined tools ----
# Tools an admin defines are fetched through a client that refuses loopback and private
# addresses, because the worker shares a network with Postgres, Redis and MinIO. Set this
# to true only for local development or tests, where the tool endpoint is on localhost.
# The API and worker refuse to start with it on when NODE_ENV=production.
TOOL_EGRESS_ALLOW_PRIVATE=false

# ---- Seed (optional; used by `bun db:seed`) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme12345
SEED_WORKSPACE_NAME=salon-saas
# Optional: pre-configure one OpenAI-compatible provider and task slots
SEED_PROVIDER_NAME=
SEED_PROVIDER_BASE_URL=
SEED_PROVIDER_KEY=
SEED_CHAT_MODEL=
SEED_VISION_MODEL=
